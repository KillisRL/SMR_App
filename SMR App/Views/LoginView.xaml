<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.LoginView"
             BackgroundColor="{StaticResource FundoPrincipal}">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,60,30,30" VerticalOptions="Center">

            <Image Source="smr_app_gold1_nobg.png"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="250"
                   HeightRequest="200"
                   Aspect="AspectFit"/>

            <Border Stroke="{StaticResource BordaInput}" 
                    StrokeThickness="1" 
                    BackgroundColor="{StaticResource FundoInput}" 
                    StrokeShape="RoundRectangle 10" 
                    Padding="15,2">
                <Entry Text="{Binding Documento}"
                       Placeholder="CPF ou CNPJ"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       Keyboard="Text"/>
            </Border>

            <Border Stroke="{StaticResource BordaInput}" 
                    StrokeThickness="1" 
                    BackgroundColor="{StaticResource FundoInput}" 
                    StrokeShape="RoundRectangle 10" 
                    Padding="15,2">
                <Entry Text="{Binding Senha_hash}"
                       Placeholder="Sua Senha"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       BackgroundColor="Transparent"
                       IsPassword="True"
                       HeightRequest="50"/>
            </Border>

            <Button Command="{Binding LogarCommand}"
                    Text="ENTRAR"
                    BackgroundColor="#D4AF37" 
                    TextColor="#121212"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Margin="0,10,0,0"/>

            <Label Text="Esqueci minha senha"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   Margin="0,5,0,15">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EsqueciSenhaCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Não possui uma conta? " TextColor="{StaticResource TextoSecundario}"/>
                        <Span Text="Cadastre-se"
                              FontAttributes="Bold"
                              TextColor="#D4AF37"
                              TextDecorations="Underline"/>
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>