<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.LoginView"
             BackgroundColor="#D3D3D3">
    <ScrollView>
        <VerticalStackLayout Background="White"
            Spacing="25" Padding="30,60,30,30" VerticalOptions="Center">

            <!-- NOME APLICATIVO -->
            <Image Source="logosmr_nobg.png"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="250"
                   HeightRequest="200"
                   Aspect="AspectFit"/>

            <Frame BackgroundColor="#3D3D3D" CornerRadius="10" Padding="15,2" HasShadow="False">
                <Entry Text="{Binding Documento}"
                       Placeholder="CPF ou CNPJ"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       HeightRequest="50"
                       Keyboard="Text"/>
            </Frame>

            <Frame BackgroundColor="#3D3D3D" CornerRadius="10" Padding="15,2" HasShadow="False">
                <Entry Text="{Binding Senha_hash}"
                       Placeholder="Sua Senha"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       IsPassword="True"
                       HeightRequest="50"/>
            </Frame>

            <Button Command="{Binding LogarCommand}"
                    Text="ENTRAR"
                    BackgroundColor="#D4AF37" 
                    TextColor="Black"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Margin="0,10,0,0"/>

            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Não possui uma conta? " TextColor="#3D3D3D"/>
                        <Span Text="Cadastre-se"
                      FontAttributes="Bold"
                      TextColor="Blue"
                      TextDecorations="Underline"/>
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>