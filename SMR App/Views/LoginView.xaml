<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.LoginView"
             Title="LoginView">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,60,30,30" VerticalOptions="Center">

            <Label Text="SMR"
                   HorizontalOptions="Center"
                   FontSize="50"/>

            <Label Text="Bem-vindo ao SMR"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Faça login para indicar amigos e ganhar prêmios"
                   TextColor="Gray"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,-15,0,10"/>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="15,2" HasShadow="False">
                <Entry Text="{Binding Documento}"
                       Placeholder="Usuário ou CPF"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       HeightRequest="50"
                       Keyboard="Text"/>
            </Frame>

            <Frame BackgroundColor="#1E1E1E" CornerRadius="10" Padding="15,2" HasShadow="False">
                <Entry Text="{Binding Senha_hash}"
                       Placeholder="Sua Senha"
                       PlaceholderColor="Gray"
                       TextColor="White"
                       IsPassword="True"
                       HeightRequest="50"/>
            </Frame>

            <Button Command="{Binding LogarCommand}"
                    Text="ENTRAR"
                    BackgroundColor="#D4AF37" 
                    TextColor="Black"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Margin="0,10,0,0"/>

            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Não possui uma conta? " TextColor="#AAAAAA"/>
                        <Span Text="Cadastre-se"
                      FontAttributes="Bold"
                      TextColor="LightBlue"
                      TextDecorations="Underline"/>
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>