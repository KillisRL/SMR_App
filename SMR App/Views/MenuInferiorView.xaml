<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.MenuInferiorView">

    <Frame x:Name="MenuBottomSheet"
           HeightRequest="400"
           TranslationY="335"
           VerticalOptions="End"
           BackgroundColor="{StaticResource FundoMenu}"
           HasShadow="True"
           Padding="20"
           BorderColor="Transparent">

        <Frame.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Down" Swiped="FecharMenu_Action"/>
        </Frame.GestureRecognizers>

        <VerticalStackLayout Spacing="30" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0">
            <ContentView BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="AbrirMenu_Action" />
                    <SwipeGestureRecognizer Direction="Up" Swiped="AbrirMenu_Action" />
                </ContentView.GestureRecognizers>

                <BoxView HeightRequest="5" WidthRequest="100" Color="{StaticResource TextoSecundario}" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Center"/>
            </ContentView>

            <Label Text="Configurações Empresa" FontSize="Title" TextColor="{StaticResource TextoPrincipal}" HorizontalOptions="Center" IsVisible="{Binding IsPessoaJuridica}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirTelaCommand}" CommandParameter="ConfigEmpresaView"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Fazer indicação" FontSize="Title" TextColor="{StaticResource TextoPrincipal}" HorizontalOptions="Center" IsVisible="{Binding IsPessoaFisica}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirTelaCommand}" CommandParameter="IndicacaoConsultarEmpresaView"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Histórico de indicações" FontSize="Title" TextColor="{StaticResource TextoPrincipal}" HorizontalOptions="Center" IsVisible="{Binding IsPessoaFisica}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirTelaCommand}" CommandParameter="HistIndicacoesView"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Validar Indicado" FontSize="Title" TextColor="{StaticResource TextoPrincipal}" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirTelaCommand}" CommandParameter="IndicacaoValidarQrCodeView"/>
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0, 30, 0, 20">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FazerLogoutCommand}"/>
                </HorizontalStackLayout.GestureRecognizers>

                <Image Source="logout_icon01.png" HeightRequest="25" WidthRequest="25" VerticalOptions="Center"/>
                <Label Text="Sair da Conta" FontSize="Title" TextColor="#C62828" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentView>