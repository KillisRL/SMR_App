<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             x:Class="SMR_App.Views.IndicacaoCadastroView"
             x:DataType="viewmodels:IndicacaoCadastroViewModel"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <!-- ScrollView para evitar que o teclado cubra os botões em telas menores -->
    <ScrollView>
        <Grid RowDefinitions="Auto, *" Padding="20">

            <!-- TÍTULO DA PÁGINA -->
            <Label Grid.Row="0" 
                   Text="NOVA INDICAÇÃO" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextoPrincipal}" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,20" />

            <!-- FORMULÁRIO (Efeito de Cartão) -->
            <Border Grid.Row="1" 
                    BackgroundColor="{StaticResource FundoMenu}" 
                    StrokeShape="RoundRectangle 12" 
                    StrokeThickness="0" 
                    Padding="20">

                <VerticalStackLayout Spacing="18">

                    <!-- RESUMO DA BONIFICAÇÃO SELECIONADA -->
                    <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                            StrokeShape="RoundRectangle 8" 
                            StrokeThickness="1" 
                            Stroke="#D4AF37" 
                            Padding="12" 
                            Margin="0,0,0,5">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BONIFICAÇÃO SELECIONADA:" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="Gray" />
                            <Label Text="{Binding BonificacaoRecebida.Nome}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#D4AF37" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- NOME DO INDICADO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome do Indicado *" 
                               FontAttributes="Bold" 
                               FontSize="14" 
                               TextColor="#D4AF37" />

                        <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                StrokeShape="RoundRectangle 8" 
                                StrokeThickness="0" 
                                HeightRequest="50" 
                                Padding="10,0">
                            <Entry Text="{Binding Nome_Indicado}" 
                                   Placeholder="Digite o nome completo..." 
                                   PlaceholderColor="Gray" 
                                   TextColor="{StaticResource TextoPrincipal}" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- CPF DO INDICADO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="CPF *" 
                               FontAttributes="Bold" 
                               FontSize="14" 
                               TextColor="#D4AF37" />

                        <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                StrokeShape="RoundRectangle 8" 
                                StrokeThickness="0" 
                                HeightRequest="50" 
                                Padding="10,0">
                            <Entry Text="{Binding Cpf}" 
                                   Keyboard="Numeric" 
                                   Placeholder="000.000.000-00" 
                                   PlaceholderColor="Gray" 
                                   TextColor="{StaticResource TextoPrincipal}" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- TELEFONE DO INDICADO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Telefone / WhatsApp *" 
                               FontAttributes="Bold" 
                               FontSize="14" 
                               TextColor="#D4AF37" />

                        <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                StrokeShape="RoundRectangle 8" 
                                StrokeThickness="0" 
                                HeightRequest="50" 
                                Padding="10,0">
                            <Entry Text="{Binding Telefone_Indicado}" 
                                   Keyboard="Telephone" 
                                   Placeholder="(00) 00000-0000" 
                                   PlaceholderColor="Gray" 
                                   TextColor="{StaticResource TextoPrincipal}" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- BOTÕES DE AÇÃO -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">

                        <!-- Botão Cancelar/Voltar -->
                        <Button Grid.Column="0" 
                                Text="VOLTAR" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=PopAsyncCommand}" 
                                BackgroundColor="Transparent" 
                                TextColor="#D4AF37" 
                                BorderColor="#D4AF37" 
                                BorderWidth="2" 
                                FontAttributes="Bold" 
                                CornerRadius="20" 
                                HeightRequest="50" />

                        <!-- Botão Cadastrar Indicação -->
                        <Button Grid.Column="1" 
                                Text="INDICAR" 
                                Command="{Binding CadastrarIndicacaoCommand}" 
                                BackgroundColor="#D4AF37" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                CornerRadius="20" 
                                HeightRequest="50" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>