<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.CadBonificacoesView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <!-- ScrollView evita que o teclado cubra os botões em telas menores -->
    <ScrollView>
        <Grid RowDefinitions="Auto, *" Padding="20">

            <!-- TÍTULO DINÂMICO ("NOVA BONIFICAÇÃO" ou "EDITAR BONIFICAÇÃO") -->
            <Label Grid.Row="0" 
                   Text="{Binding TituloPagina}" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextoPrincipal}" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,25" />

            <!-- FORMULÁRIO (Efeito de Cartão) -->
            <Border Grid.Row="1" 
                    BackgroundColor="{StaticResource FundoMenu}" 
                    StrokeShape="RoundRectangle 10" 
                    StrokeThickness="0" 
                    Padding="20">

                <VerticalStackLayout Spacing="20">

                    <!-- NOME DA BONIFICAÇÃO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome da Bonificação *" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#D4AF37" />

                        <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                StrokeShape="RoundRectangle 8" 
                                StrokeThickness="0" 
                                HeightRequest="50" 
                                Padding="10,0">
                            <Entry Text="{Binding Nome}" 
                                   Placeholder="Ex: Desconto de R$ 5,00" 
                                   PlaceholderColor="Gray"
                                   TextColor="{StaticResource TextoPrincipal}" 
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- LINHA LADO A LADO: TIPO E VALOR/QUANTIDADE -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <!-- TIPO -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Tipo *" 
                                   FontAttributes="Bold" 
                                   FontSize="14"
                                   TextColor="#D4AF37" />

                            <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                    StrokeShape="RoundRectangle 8" 
                                    StrokeThickness="0" 
                                    HeightRequest="50" 
                                    Padding="10,0">
                                <Picker ItemsSource="{Binding Tipos}" 
                                        SelectedItem="{Binding TipoSelecionado}" 
                                        TitleColor="Gray"
                                        TextColor="{StaticResource TextoPrincipal}" 
                                        VerticalOptions="Center" />
                            </Border>

                        </VerticalStackLayout>

                        <!-- VALOR / QUANTIDADE -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Valor / Qtd *" 
                                   FontAttributes="Bold" 
                                   FontSize="14"
                                   TextColor="#D4AF37" />

                            <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                    StrokeShape="RoundRectangle 8" 
                                    StrokeThickness="0" 
                                    HeightRequest="50" 
                                    Padding="10,0">
                                <Entry Text="{Binding Valor}" 
                                       Keyboard="Numeric" 
                                       Placeholder="0,00" 
                                       PlaceholderColor="Gray"
                                       TextColor="{StaticResource TextoPrincipal}" 
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- LINHA LADO A LADO: SWITCHES (MGM e ATIVO) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <!-- SWITCH MGM -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="MGM (Indicação)" 
                                   FontAttributes="Bold" 
                                   FontSize="14"
                                   TextColor="#D4AF37" />

                            <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                    StrokeShape="RoundRectangle 8" 
                                    StrokeThickness="0" 
                                    HeightRequest="50" 
                                    Padding="12,0">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Switch Grid.Column="0" 
                                            IsToggled="{Binding Mgm}" 
                                            OnColor="#D4AF37" 
                                            ThumbColor="White" 
                                            VerticalOptions="Center" />
                                    <Label Grid.Column="1" 
                                           Text="É MGM?" 
                                           TextColor="{StaticResource TextoPrincipal}" 
                                           FontSize="14"
                                           Margin="0,0,20,0"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- SWITCH ATIVO -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Status" 
                                   FontAttributes="Bold" 
                                   FontSize="14"
                                   TextColor="#D4AF37" />

                            <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                    StrokeShape="RoundRectangle 8" 
                                    StrokeThickness="0" 
                                    HeightRequest="50" 
                                    Padding="12,0">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Switch Grid.Column="0" 
                                            IsToggled="{Binding Ativo}"
                                            HorizontalOptions="End"
                                            OnColor="#D4AF37" 
                                            ThumbColor="White" 
                                            VerticalOptions="Center" />
                                    
                                    <Label Grid.Column="1" 
                                           Text="Ativo"
                                           Margin="0,0,20,0"
                                           TextColor="{StaticResource TextoPrincipal}" 
                                           FontSize="14" 
                                           VerticalOptions="Center" />

                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- DESCRIÇÃO -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Descrição" 
                               FontAttributes="Bold" 
                               FontSize="14"
                               TextColor="#D4AF37" />

                        <Border BackgroundColor="{StaticResource FundoPrincipal}" 
                                StrokeShape="RoundRectangle 8" 
                                StrokeThickness="0" 
                                HeightRequest="160" 
                                Padding="10">
                            <Editor Text="{Binding Descricao}" 
                                    Placeholder="Detalhes ou regras de uso..." 
                                    PlaceholderColor="Gray"
                                    TextColor="{StaticResource TextoPrincipal}" 
                                    AutoSize="Disabled" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- BOTÕES DE AÇÃO -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,15,0,0">

                        <!-- Botão Cancelar -->
                        <Button Grid.Column="0" 
                                Text="CANCELAR" 
                                Command="{Binding CancelarCommand}" 
                                BackgroundColor="Transparent" 
                                TextColor="#D4AF37" 
                                BorderColor="#D4AF37" 
                                BorderWidth="2" 
                                FontAttributes="Bold" 
                                CornerRadius="20" 
                                HeightRequest="50" />

                        <!-- Botão Salvar (Texto dinâmico "CADASTRAR" ou "SALVAR") -->
                        <Button Grid.Column="1" 
                                Text="{Binding NomeBotaoAcao}" 
                                Command="{Binding SalvarCommand}" 
                                BackgroundColor="#D4AF37" 
                                TextColor="Black" 
                                FontAttributes="Bold" 
                                CornerRadius="20" 
                                HeightRequest="50" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>