<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.ConfigEmpresaView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Padding="20" Margin="0,20,0,30">

            <!-- Botões Principais (Grid 2x2) -->
            <Grid RowDefinitions="Auto, Auto" 
                  ColumnDefinitions="*, *" 
                  RowSpacing="20" 
                  ColumnSpacing="20">

                <Button Text="RECOMPENSAS" 
                        Grid.Row="0" Grid.Column="0" 
                        BackgroundColor="{StaticResource FundoBotao}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="80"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="RecompensasView"/>

                <Button Text="GERENCIAR RECOMPENSAS" 
                        Grid.Row="0" Grid.Column="1" 
                        BackgroundColor="{StaticResource FundoBotao}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="80"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="GerenciarRecompensasView"/>

                <Button Text="BONIFICAÇÕES" 
                        Grid.Row="1" Grid.Column="0" 
                        BackgroundColor="{StaticResource FundoBotao}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="80"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="BonificacoesView"/>

                <Button Text="GERENCIAR BONIFICAÇÕES" 
                        Grid.Row="1" Grid.Column="1" 
                        BackgroundColor="{StaticResource FundoBotao}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="15"
                        HeightRequest="80"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="GerenciarBonificacoesView"/>
            </Grid>

            <!-- Botão de Relatórios -->
            <Button Text="RELATÓRIOS" 
                    BackgroundColor="{StaticResource FundoBotao}" TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="60"
                    WidthRequest="200"
                    HorizontalOptions="Center"
                    Command="{Binding AbrirTelaCommand}"
                    CommandParameter="RelatoriosView"/>

            <!-- Seção Importar Clientes -->
            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label Text="IMPORTAR CLIENTES"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="{StaticResource TextoTerciario}" 
                       HorizontalOptions="Center"/>

                <!-- Layout Horizontal: Ícone original + Botão de Ver Exemplo -->
                <HorizontalStackLayout Spacing="25" HorizontalOptions="Center" VerticalOptions="Center">

                    <!-- Ícone Original de Importação -->
                    <Image Source="import_icon.png" WidthRequest="75" HeightRequest="75" HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportarClientesCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Botão para alternar a exibição do exemplo -->
                    <Button Text="Ver Exemplo CSV" 
                            Command="{Binding AlternarExemploCommand}"
                            BackgroundColor="#333333"
                            TextColor="#D4AF37"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="45"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Box de Exemplo (Aparece/Sobe dinamicamente via IsVisible) -->
                <Border Stroke="#D4AF37" 
                        StrokeThickness="1" 
                        BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 10" 
                        Padding="15" 
                        WidthRequest="300"
                        IsVisible="{Binding ExibirExemplo}">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Formato esperado (.csv):" 
                               TextColor="#D4AF37" 
                               FontAttributes="Bold" 
                               FontSize="13"/>

                        <Label Text="Nome;Documento&#10;luiz;00000000000&#10;ueler;00000000000" 
                               TextColor="{StaticResource TextoPrincipal}"
                               FontSize="12"
                               LineBreakMode="WordWrap"/>

                        <Label Text="* Separado por ponto e vírgula (;)" 
                               TextColor="{StaticResource TextoSecundario}" 
                               FontSize="10"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>