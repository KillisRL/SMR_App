<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.PrincipalView"
             xmlns:views="clr-namespace:SMR_App.Views"
             ControlTemplate="{StaticResource MainPageTemplate}"
             BackgroundColor="White">
    <Grid>
        
        <!-- LOGO CENTRALIZADA APLICATIVO -->
        <Image Source="logosmr.png"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   MaximumWidthRequest="250"
                   HeightRequest="200"
                   Aspect="AspectFit"/>
        
        <!-- MENU -->
        <Frame x:Name="MenuBottomSheet"
               HeightRequest="400"
               TranslationY="330"
               VerticalOptions="End"
               BackgroundColor="#D3D3D3"
               HasShadow="True"
               Padding="20"
               BorderColor="Transparent">

            <Frame.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Down" Swiped="FecharMenu_Action"/>
            </Frame.GestureRecognizers>

            <VerticalStackLayout Spacing="30" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0">
                <ContentView BackgroundColor="#D3D3D3">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AbrirMenu_Action" />
                        <SwipeGestureRecognizer Direction="Up" Swiped="AbrirMenu_Action" />
                    </ContentView.GestureRecognizers>

                    <BoxView HeightRequest="5" 
                             WidthRequest="100" 
                             Color="Black" 
                             CornerRadius="2" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"/>
                </ContentView>

                <!-- CONFIGURAÇÃO EMPRESA -->
                <Label
                    x:Name="MenuConfigEmpresa"
                    Text="Configurações Empresa" 
                    FontSize="Title" 
                    TextColor="Black"                     
                    HorizontalOptions="Center"
                    IsVisible="{Binding VisualizarConfiguracoesEmpresa}">
                    
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTelaCommand}"
                                              CommandParameter="ConfigEmpresaView"/>
                    </Label.GestureRecognizers>
                </Label>
                
                <!-- FAZER INDICAÇÃO -->
                <Label Text="Fazer indicação"
                       FontSize="Title"
                       TextColor="Black"
                       HorizontalOptions="Center"/>
                
                <!-- HISTÓRIO DE INDICAÇÃO -->
                <Label Text="Histórico de indicações"
                       FontSize="Title"
                       TextColor="Black"
                       HorizontalOptions="Center"/>
                
                <!-- VALDAR INDICAÇÃO -->
                <Label Text="Validar Indicado"
                       FontSize="Title"
                       TextColor="Black"
                       HorizontalOptions="Center"/>
                
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>