<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.PrincipalView"
             xmlns:views="clr-namespace:SMR_App.Views"
             ControlTemplate="{StaticResource MainPageTemplate}"
             BackgroundColor="White">
    <Grid>
        <Frame x:Name="MenuBottomSheet"
           VerticalOptions="End"
           HeightRequest="800"
           TranslationY="500"
           BackgroundColor="#D3D3D3"
           CornerRadius="0"
           Margin="0,0,0,-300"  HasShadow="True"
           Padding="20"
           BorderColor="Transparent">

            <Frame.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Down" Swiped="FecharMenu_Action"/>
            </Frame.GestureRecognizers>

            <VerticalStackLayout Spacing="30" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0">
                <ContentView Grid.Row="2" BackgroundColor="#D3D3D3">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="AbrirMenu_Action" />
                        <SwipeGestureRecognizer Direction="Up" Swiped="AbrirMenu_Action" />
                    </ContentView.GestureRecognizers>

                    <BoxView HeightRequest="5" 
                             WidthRequest="100" 
                             Color="Black" 
                             CornerRadius="2" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center"/>
                </ContentView>

                <Label Text="Relatórios" FontSize="22" TextColor="Black" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTela}"
                                              CommandParameter="{x:Type TypeName=views:CadastroPessoaView}"/>
                    </Label.GestureRecognizers>
                </Label>
                
                <Label
                    x:Name="MenuConfigEmpresa"
                    Text="Configurações Empresa" 
                    FontSize="22" 
                    TextColor="Black"                     
                    HorizontalOptions="Center"
                    IsVisible="{Binding VisualizarConfiguracoesEmpresa}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirTela}"
                                              CommandParameter="{x:Type TypeName=views:ConfigEmpresaView}"/>
                    </Label.GestureRecognizers>
                </Label>
                
                <Label Text="Fazer indicação" FontSize="22" TextColor="Black" HorizontalOptions="Center"/>
                <Label Text="Histórico de indicações" FontSize="22" TextColor="Black" HorizontalOptions="Center"/>
                <Label Text="Validar Indicado" FontSize="22" TextColor="Black" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>