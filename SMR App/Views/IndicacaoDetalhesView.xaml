<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             x:Class="SMR_App.Views.IndicacaoDetalhesView"
             xmlns:enums="clr-namespace:SMRDominio.ClasseIndicacao;assembly=SMRDominio"
             x:DataType="viewmodels:IndicacaoDetalhesViewModel"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <ScrollView>
        <Grid RowDefinitions="Auto, *" Padding="20">

            <!-- TÍTULO DA PÁGINA COM NÚMERO DO PROTOCOLO -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,10,0,20" HorizontalOptions="Center">
                <Label Text="DETALHES DA INDICAÇÃO" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource TextoPrincipal}" 
                       HorizontalOptions="Center" />

                <Label Text="{Binding IndicacaoDetalhe.IDIndicacao, StringFormat='#Protocolo: {0}'}" 
                       FontSize="13" 
                       FontAttributes="Bold" 
                       TextColor="#D4AF37" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="16">

                <!-- CARD 1: DADOS DO INDICADO E STATUS -->
                <Border BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0" 
                        Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" 
                                   Text="DADOS DO INDICADO" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="Gray" />

                            <!-- Status em Destaque -->
                            <Border Grid.Column="1" 
                                    BackgroundColor="{StaticResource FundoPrincipal}" 
                                    Stroke="#D4AF37" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 8" 
                                    Padding="8,3">
                                <Label Text="{Binding IndicacaoDetalhe.StatusIndicacao}" 
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="#D4AF37" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Nome" FontSize="11" TextColor="Gray" />
                            <Label Text="{Binding IndicacaoDetalhe.NomeIndicado}" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextoPrincipal}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="CPF" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding IndicacaoDetalhe.CPF}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Telefone" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding IndicacaoDetalhe.TelefoneIndicado}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Data de Indicação" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding IndicacaoDetalhe.DataIndicacao, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Data de Validação" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding IndicacaoDetalhe.DataValidacao, StringFormat='{0:dd/MM/yyyy HH:mm}', TargetNullValue='Pendente'}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- CARD 2: BONIFICAÇÃO E EMPRESA -->
                <Border BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0" 
                        Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="EMPRESA E BONIFICAÇÃO" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="Gray" />

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Empresa Parceira" FontSize="11" TextColor="Gray" />
                            <Label Text="{Binding IndicacaoDetalhe.RazaoSocial}" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="#D4AF37" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Recompensa / Bônus" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding IndicacaoDetalhe.NomeBonificacao}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextoPrincipal}" />

                                <Label Text="Detalhes" FontSize="11" TextColor="Gray" Margin="0,10,0,0"/>
                                <Label Text="{Binding IndicacaoDetalhe.DescricaoBonificacao}" 
                                       FontSize="12" 
                                       TextColor="Gray" 
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- CARD 3: DADOS DO PROMOTOR -->
                <Border BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0" 
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PROMOTOR RESPONSÁVEL" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="Gray" />
                        <Label Text="{Binding IndicacaoDetalhe.NomePromotor}" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource TextoPrincipal}" />
                    </VerticalStackLayout>
                </Border>

                <!-- BOTÃO: VALIDAR INDICAÇÃO (Empresa) -->
                <Button Text="VALIDAR INDICAÇÃO" 
                        Command="{Binding ConfirmarValidacaoEmpresaCommand}" 
                        BackgroundColor="#2ecc71" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="20" 
                        HeightRequest="50" 
                        Margin="0,5,0,0"
                        IsVisible="{Binding PodeVisualizarValidacao}" />

                <!-- BOTÃO: ENVIAR INDICAÇÃO (Promotor) -->
                <Button Text="ENVIAR INDICAÇÃO" 
                         Command="{Binding IndicacaoAlterarSituacaoCommand}"
                         CommandParameter="{x:Static enums:IndicacaoStatus.Enviada}"
                         BackgroundColor="Transparent" 
                         TextColor="#D4AF37" 
                         BorderColor="#D4AF37" 
                         BorderWidth="2" 
                         FontAttributes="Bold" 
                         CornerRadius="20" 
                         HeightRequest="50" 
                         Margin="0,10,0,0" 
                         IsVisible="{Binding PodeVisualizar}" />

                <!-- BOTÃO: CANCELAR (Comum) -->
                <Button Text="CANCELAR INDICAÇÃO" 
                        Command="{Binding IndicacaoAlterarSituacaoCommand}"
                        CommandParameter="{x:Static enums:IndicacaoStatus.Cancelada}"
                        BackgroundColor="Transparent" 
                        TextColor="#e74c3c"
                        BorderColor="#e74c3c"
                        BorderWidth="2" 
                        FontAttributes="Bold" 
                        CornerRadius="20" 
                        HeightRequest="50" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>