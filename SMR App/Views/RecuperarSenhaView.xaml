<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.RecuperarSenhaView"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30,60,30,30" VerticalOptions="Center">

            <Image Source="logosmr_nobg.png"
                   HorizontalOptions="Center"
                   MaximumWidthRequest="180"
                   Aspect="AspectFit"
                   Margin="0,0,0,10"/>

            <Label Text="Recuperação de Senha"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextoPrincipal}"
                   HorizontalOptions="Center" />

            <Label Text="{Binding InstrucaoTexto}"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,15" />

            <Border IsVisible="{Binding ExibirCampoEmail}"
                    Stroke="{StaticResource BordaInput}" StrokeThickness="1" 
                    BackgroundColor="{StaticResource FundoInput}" StrokeShape="RoundRectangle 10" Padding="15,2">
                <Entry Text="{Binding Email}"
                       Placeholder="Digite seu e-mail de cadastro"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       Keyboard="Email"/>
            </Border>

            <Border IsVisible="{Binding ExibirCampoCodigo}"
                    Stroke="{StaticResource BordaInput}" StrokeThickness="1" 
                    BackgroundColor="{StaticResource FundoInput}" StrokeShape="RoundRectangle 10" Padding="15,2">
                <Entry Text="{Binding CodigoVerificacao}"
                       Placeholder="Código de 6 dígitos"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       Keyboard="Numeric"
                       MaxLength="6"/>
            </Border>

            <Border IsVisible="{Binding ExibirCampoNovaSenha}"
                    Stroke="{StaticResource BordaInput}" StrokeThickness="1" 
                    BackgroundColor="{StaticResource FundoInput}" StrokeShape="RoundRectangle 10" Padding="15,2">
                <Entry Text="{Binding NovaSenha}"
                       Placeholder="Digite a nova senha"
                       PlaceholderColor="{StaticResource TextoSecundario}"
                       TextColor="{StaticResource TextoPrincipal}"
                       IsPassword="True"/>
            </Border>

            <Button Command="{Binding AvancarCommand}"
                    Text="{Binding TextoBotao}"
                    BackgroundColor="#D4AF37" 
                    TextColor="#121212"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10"
                    Margin="0,15,0,0"/>

            <Label Text="Voltar ao Login"
                   TextColor="{StaticResource TextoSecundario}"
                   HorizontalOptions="Center"
                   Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>