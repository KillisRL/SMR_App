<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             xmlns:classesPessoa="clr-namespace:SMRDominio.ClassePessoa;assembly=SMRDominio"
             x:Class="SMR_App.Views.HistIndicacoesView"
             x:DataType="viewmodels:HistIndicacoesViewModel"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <!-- O Grid principal contém: Cabeçalho/Filtros (Auto), Lista (*), Botões Inferiores (Auto) -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- LINHA 0: TÍTULO E PESQUISA DE EMPRESA -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" Margin="0,0,0,20">

            <Label Text="CONSULTAR HISTÓRICO POR EMPRESA " 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextoPrincipal}" 
                   HorizontalOptions="Center" />

            <!-- Barra de Pesquisa por Razão Social (Conectado a RazaoSocial da ViewModel) -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Pesquisa por Razão Social" 
                       FontAttributes="Bold" 
                       FontSize="14" 
                       TextColor="{StaticResource TextoPrincipal}" />

                <Border BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 8" 
                        StrokeThickness="0" 
                        HeightRequest="45" 
                        Padding="5,0">
                    <SearchBar x:Name="SearchBarPesquisa"
                               Text="{Binding RazaoSocial}"
                               Placeholder="Digite a razão social..." 
                               PlaceholderColor="Gray"
                               TextColor="{StaticResource TextoPrincipal}"
                               BackgroundColor="Transparent" 
                               CancelButtonColor="{StaticResource TextoPrincipal}"
                               SearchCommand="{Binding ConsultarEmpresaCommand}" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- LINHA 1: LISTA DE EMPRESAS (CollectionView Comprido) -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaEmpresa}" 
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="1" 
                                 VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,30,0,0">
                    <Label Text="Nenhuma empresa encontrada." 
                           TextColor="Gray" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="classesPessoa:Empresa">
                    <!-- Card Comprido da Empresa (Clicável para abrir o histórico) -->
                    <Border BackgroundColor="{StaticResource FundoMenu}" 
                            StrokeShape="RoundRectangle 15" 
                            StrokeThickness="0" 
                            HeightRequest="80" 
                            Padding="15,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistIndicacoesViewModel}}, Path=AbrirHistoricoCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <!-- Layout Horizontal: Círculo na esquerda e Dados na direita -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">

                            <!-- Indicador Visual / Círculo -->
                            <Ellipse Grid.Column="0"
                                     WidthRequest="45" 
                                     HeightRequest="45" 
                                     Fill="#D4AF37" 
                                     VerticalOptions="Center" 
                                     HorizontalOptions="Center" />

                            <!-- Textos Empilhados (Razão Social e CNPJ) -->
                            <VerticalStackLayout Grid.Column="1" 
                                                 VerticalOptions="Center" 
                                                 Spacing="2">

                                <!-- RAZÃO SOCIAL -->
                                <Label Text="{Binding razao_social}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="{StaticResource TextoPrincipal}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <!-- CNPJ -->
                                <Label Text="{Binding cnpj, StringFormat='CNPJ: {0}'}" 
                                       FontSize="12" 
                                       TextColor="Gray"
                                       LineBreakMode="NoWrap" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>