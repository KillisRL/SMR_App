<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.PessoaCadastroView"
             Title="Cadastrar Pessoa">
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Tipo de Pessoa" FontAttributes="Bold" />
            <Picker
                      Title="Tipo de Usuário" 
                      TitleColor="White"
                      ItemsSource="{Binding pessoaTiposDisponiveis}"
                      SelectedItem="{Binding Id_pessoatipo}"
                      BackgroundColor="White"
                      TextColor="Black"
                      FontAttributes="Bold"
                      HorizontalOptions="Start"
                      WidthRequest="150"
                      HeightRequest="60"/>  

            <Label Text="Nome Completo / Razão Social" FontAttributes="Bold" />
            <Entry Text="{Binding Nome}" 
                   Placeholder="Digite o nome completo" 
                   Keyboard="Text" />

            <Label Text="CPF ou CNPJ" FontAttributes="Bold" />
            <Entry Text="{Binding Documento}" 
                   Placeholder="Apenas números" 
                   Keyboard="Numeric" />

            <Label Text="Telefone" FontAttributes="Bold" />
            <Entry Text="{Binding Telefone}" 
                   Placeholder="(00) 00000-0000" 
                   Keyboard="Telephone" />

            <Label Text="E-mail" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" 
                   Placeholder="exemplo@email.com" 
                   Keyboard="Email" />

            <Label Text="Login" FontAttributes="Bold" />
            <Entry Text="{Binding Login}" 
                   Placeholder="Crie um nome de usuário" 
                   Keyboard="Text" />

            <Label Text="Senha" FontAttributes="Bold" />
            <Entry Text="{Binding Senha_hash}" 
                   Placeholder="Digite sua senha" 
                   IsPassword="True" />

            <Label Text="Data de Cadastro" FontAttributes="Bold" />
            <DatePicker Date="{Binding Data_cadastro}" IsEnabled="False" />

            <Button Text="Salvar Cadastro" 
                    Command="{Binding SalvarCommand}" 
                    BackgroundColor="#2196F3" 
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0, 20, 0, 0"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>