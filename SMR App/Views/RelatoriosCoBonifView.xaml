<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SMR_App.Views.RelatoriosCoBonifView">

    <Grid RowDefinitions="Auto, Auto, Auto, *, 80" Padding="15">

        <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yyyy" FontAttributes="Bold"/>
        <DatePicker Date="{Binding DataFim}" Format="dd/MM/yyyy" FontAttributes="Bold"/>

        <!-- Cabeçalho: Home, Usuário e Perfil -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="0, 10, 0, 20">
            <ImageButton Grid.Column="0" Source="home_icon.png" WidthRequest="40" HeightRequest="40" Command="{Binding VoltarInicioCommand}"/>
            <Label Grid.Column="1" Text="{Binding NomeUsuario}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Image Grid.Column="2" Source="profile_icon.png" WidthRequest="40" HeightRequest="40"/>
        </Grid>

        <!-- Navegação do Relatório -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0, 0, 0, 20">
            <ImageButton Grid.Column="0" Source="arrow_left.png" WidthRequest="30" Command="{Binding RelatorioAnteriorCommand}"/>

            <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="#E0E0E0" Padding="15, 10" HorizontalOptions="Center">
                <Label Text="CONTROLE&#10;BONIFICAÇÃO" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            </Border>

            <ImageButton Grid.Column="2" Source="arrow_right.png" WidthRequest="30" Command="{Binding ProximoRelatorioCommand}"/>
        </Grid>

        <!-- Filtros de Data -->
        <HorizontalStackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Center" Margin="0, 0, 0, 20">
            <Image Source="calendar_icon.png" WidthRequest="25" VerticalOptions="Center"/>
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#E0E0E0" Padding="10, 5">
                <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yyyy" FontAttributes="Bold"/>
            </Border>
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="#E0E0E0" Padding="10, 5">
                <DatePicker Date="{Binding DataFim}" Format="dd/MM/yyyy" FontAttributes="Bold"/>
            </Border>
        </HorizontalStackLayout>

        <!-- Container do Gráfico -->
        <Border Grid.Row="3" Stroke="#B39DDB" StrokeThickness="2" StrokeShape="RoundRectangle 5" Padding="10">
            <VerticalStackLayout>
                <Label Text="Controle Bonificação" HorizontalOptions="Center" FontSize="16"/>
                <Label Text="● Custo Indicação" TextColor="#4285F4" HorizontalOptions="Center" FontSize="12" Margin="0,0,0,10"/>

                <!-- O controle do LiveCharts2 entrará aqui -->
                <!-- <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" /> -->
                <BoxView Color="LightGray" HeightRequest="200" HorizontalOptions="Fill"/>
                <!-- Placeholder -->
            </VerticalStackLayout>
        </Border>

        <!-- Área Inferior / Bottom Sheet -->
        <Border Grid.Row="4" BackgroundColor="#D3D3D3" StrokeThickness="0" Margin="-15, 15, -15, -15">
            <BoxView Color="Black" HeightRequest="5" WidthRequest="100" HorizontalOptions="Center" VerticalOptions="Start" Margin="0, 10, 0, 0"/>
        </Border>
    </Grid>
</ContentPage>