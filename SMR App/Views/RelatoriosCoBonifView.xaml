<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SMR_App.Views.RelatoriosCoBonifView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <!-- Ajustei as linhas para o gráfico ocupar o espaço central flexível (*) -->
    <Grid RowDefinitions="Auto, Auto, *, 80" Padding="15">

        <!-- Navegação do Relatório -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0, 0, 0, 20">
            <ImageButton Grid.Column="0" Source="arrow_left.png" WidthRequest="30" Command="{Binding RelatorioAnteriorCommand}"/>

            <!-- Fundo alterado para FundoMenu -->
            <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="15, 10" HorizontalOptions="Center">
                <Label Text="CONTROLE&#10;BONIFICAÇÃO" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextoPrincipal}"/>
            </Border>

            <ImageButton Grid.Column="2" Source="arrow_right.png" WidthRequest="30" Command="{Binding ProximoRelatorioCommand}"/>
        </Grid>

        <!-- Filtros de Data -->
        <HorizontalStackLayout Grid.Row="1" Spacing="15" HorizontalOptions="Center" Margin="0, 0, 0, 20">
            <Image Source="calendar_icon.png" WidthRequest="25" VerticalOptions="Center"/>

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10, 5">
                <DatePicker Date="{Binding DataInicio}" Format="dd/MM/yyyy" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
            </Border>

            <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10, 5">
                <DatePicker Date="{Binding DataFim}" Format="dd/MM/yyyy" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
            </Border>
        </HorizontalStackLayout>

        <!-- Container do Gráfico -->
        <!-- Usa o FundoMenu para dar o aspecto de "Cartão" e TextoSecundario para uma borda suave -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource FundoMenu}" Stroke="{StaticResource TextoSecundario}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10">
            <Grid RowDefinitions="Auto, Auto, *">
                <Label Grid.Row="0" Text="Controle Bonificação" HorizontalOptions="Center" FontSize="16" TextColor="{StaticResource TextoPrincipal}"/>

                <!-- A cor da legenda permanece azulada (CornflowerBlue) para combinar com a linha do gráfico que configuramos na ViewModel -->
                <Label Grid.Row="1" Text="● Custo Indicação" TextColor="CornflowerBlue" HorizontalOptions="Center" FontSize="12" Margin="0,0,0,10"/>

                <!-- Gráfico Oficial do LiveCharts -->
                <lvc:CartesianChart 
                    Grid.Row="2"
                    Series="{Binding SeriesGrafico}" 
                    XAxes="{Binding EixosX}" 
                    YAxes="{Binding EixosY}" />
            </Grid>
        </Border>

        <!-- Área Inferior / Bottom Sheet igual a PrincipalView -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Margin="-15, 15, -15, -15">
            <!-- Puxador (Handle) com cor baseada no TextoSecundario e cantos arredondados -->
            <BoxView Color="{StaticResource TextoSecundario}" HeightRequest="5" WidthRequest="100" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Start" Margin="0, 10, 0, 0"/>
        </Border>

    </Grid>
</ContentPage>