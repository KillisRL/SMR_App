<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             x:Class="SMR_App.Views.RelatoriosView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <Grid RowDefinitions="Auto, Auto, *, 80" Padding="15">

        <!-- Barra de Pesquisa -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Margin="0, 10, 0, 20">
            <Label Text="Pesquisa" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>

            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10, 5">
                <SearchBar Placeholder="" Text="{Binding TextoPesquisa}" BackgroundColor="Transparent" TextColor="{StaticResource TextoPrincipal}"/>
            </Border>
        </VerticalStackLayout>

        <!-- Botões de Opções do Relatório (Grid 2 colunas) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" RowDefinitions="100, 100" ColumnSpacing="15" RowSpacing="15" VerticalOptions="Center">

            <!-- Botão 1: Ranking Promotores -->
            <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10">
                <Button Text="RANKING&#10;PROMOTORES" 
                        TextColor="{StaticResource TextoPrincipal}" 
                        FontAttributes="Bold" 
                        FontSize="14"
                        BackgroundColor="Transparent"
                        Command="{Binding IrParaRankingCommand}"/>
            </Border>

            <!-- Botão 2: Controle Bonificação (O que criamos o gráfico) -->
            <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10">
                <Button Text="CONTROLE&#10;BONIFICAÇÃO" 
                        TextColor="{StaticResource TextoPrincipal}" 
                        FontAttributes="Bold" 
                        FontSize="14"
                        BackgroundColor="Transparent"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="RelatoriosCoBonifView"/>
            </Border>

            <!-- Botão 3: Conversão -->
            <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Padding="10">
                <Button Text="CONVERSÃO" 
                        TextColor="{StaticResource TextoPrincipal}" 
                        FontAttributes="Bold" 
                        FontSize="14"
                        BackgroundColor="Transparent"
                        Command="{Binding IrParaConversaoCommand}"/>
            </Border>
        </Grid>

        <!-- Área Inferior / Bottom Sheet -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource FundoMenu}" StrokeThickness="0" Margin="-15, 15, -15, -15">
            <BoxView Color="{StaticResource TextoSecundario}" HeightRequest="5" WidthRequest="100" CornerRadius="2" HorizontalOptions="Center" VerticalOptions="Start" Margin="0, 10, 0, 0"/>
        </Border>

    </Grid>
</ContentPage>