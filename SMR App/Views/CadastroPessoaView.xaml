<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.CadastroPessoaView"
             BackgroundColor="#D3D3D3">
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Tipo de Pessoa" FontAttributes="Bold"
                   F/>
            <Picker
                      Title="Tipo de Usuário" 
                      TitleColor="White"
                      ItemsSource="{Binding pessoaTiposDisponiveis}"
                      SelectedItem="{Binding Id_pessoa_tipo}"
                      BackgroundColor="White"
                      TextColor="Black"
                      FontAttributes="Bold"
                      HorizontalOptions="Start"
                      WidthRequest="150"
                      HeightRequest="60"/>

            <Label Text="Nome (Promotor) ou Nome Fantasia (Empresa)" FontAttributes="Bold" />
            <Entry Text="{Binding Nome}" 
                   Placeholder="Como você quer ser chamado?" 
                   Keyboard="Text" />

            <!-- CAMPOS DE CNPJ TELEFONE 1 E 2 CASO FOR EMPRESA -->
            <VerticalStackLayout IsVisible="{Binding IsEmpresaVisible}"
                                 Spacing="15">
                
                <Label Text="Razão Social" FontAttributes="Bold" />
                <Entry Text="{Binding Razao_social}" 
                       Placeholder="Nome Jurídico do CNPJ)" 
                       Keyboard="Text" />
                
                <Label Text="CNPJ" FontAttributes="Bold" />
                <Entry Text="{Binding Documento}" 
                       Placeholder="Apenas números (CNPJ)" 
                       Keyboard="Numeric" />
                
                <Label Text="Telefone1" FontAttributes="Bold" />
                <Entry Text="{Binding Telefone1}"  
                       Placeholder="(00) 00000-0000"
                       Keyboard="Telephone" />
                
                <Label Text="Telefone 2:" FontAttributes="Bold"/>
                <Entry Text="{Binding Telefone2}"
                       Placeholder="(00) 00000-0000"
                       Keyboard="Telephone"/>
            </VerticalStackLayout>
            
            <!-- CAMPO DE CELULAR CASO FOR PROMOTOR -->
            <VerticalStackLayout IsVisible="{Binding IsPromotorVisible}"
                                 Spacing="15">
                <Label Text="CPF" FontAttributes="Bold" />
                <Entry Text="{Binding Documento}" 
                       Placeholder="Apenas números (CPF)" 
                       Keyboard="Numeric" />
                <Label Text="Celular:" FontAttributes="Bold"/>
                <Entry Text="{Binding Celular}"
                       Placeholder="(00) 00000-0000"/>
            </VerticalStackLayout>

            <Label Text="E-mail" FontAttributes="Bold" />
            <Entry Text="{Binding Email}" 
                   Placeholder="exemplo@email.com" 
                   Keyboard="Email" />
            <!--
            <Label Text="Login" FontAttributes="Bold" />
            <Entry Text="{Binding Login}" 
                   Placeholder="Crie um nome de usuário" 
                   Keyboard="Text" /> -->

            <Label Text="Senha" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*, Auto">

                    <Entry Grid.Column="0"
                           Text="{Binding Senha_hash}" 
                           Placeholder="Digite sua senha" 
                           IsPassword="True"
                           IsEnabled="{Binding IsSenhaHabilitada}" />
                    <Button Grid.Column="1"
                            Text="🔓 Alterar"
                            Command="{Binding DesbloquearSenhaCommand}"
                            IsVisible="{Binding IsBotaoSenhaVisivel}"
                            BackgroundColor="#E0E0E0"
                            TextColor="Black"
                            FontAttributes="Bold"
                            HeightRequest="45"
                            CornerRadius="8"
                            Margin="10,0,0,0"
                            Padding="15,0" />
                </Grid>

            <Button Text="Salvar Cadastro" 
                    Command="{Binding SalvarCommand}" 
                    BackgroundColor="#2196F3" 
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0, 20, 0, 0"
                    HeightRequest="50"
                    FontAttributes="Bold"/>

            <!-- BOTÃO EXCLUIR -->
            <Button Text="Excluir Minha Conta" 
                    Command="{Binding ExcluirCommand}" 
                    IsVisible="{Binding IsEdicao}"
                    BackgroundColor="#FF3B30" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0, 15, 0, 30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>