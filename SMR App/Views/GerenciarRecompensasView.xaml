<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SMR_App.Views.GerenciarRecompensasView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,0,20,20">

        <!-- LINHA 0: Título e Filtro de Pesquisa -->
        <VerticalStackLayout Grid.Row="0" Spacing="15" Margin="0,20,0,15">
            <Label Text="RECOMPENSAS ENTREGUES" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextoPrincipal}" 
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Pesquisar por nome do cliente:" 
                       FontAttributes="Bold" 
                       FontSize="14" 
                       TextColor="{StaticResource TextoPrincipal}" />

                <Border BackgroundColor="{StaticResource FundoMenu}" 
                        StrokeShape="RoundRectangle 8" 
                        StrokeThickness="0" 
                        HeightRequest="45" 
                        Padding="5,0">
                    <SearchBar Text="{Binding BuscaNome}"
                               Placeholder="Digite o nome..." 
                               PlaceholderColor="Gray"
                               TextColor="{StaticResource TextoPrincipal}"
                               BackgroundColor="Transparent" 
                               CancelButtonColor="{StaticResource TextoPrincipal}" 
                               SearchCommand="{Binding ConsultarHistoricoCommand}" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- LINHA 1: Lista de Histórico -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaHistorico}" 
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,30,0,0">
                    <Label Text="Nenhuma recompensa foi entregue ainda." 
                           TextColor="Gray" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource FundoMenu}" 
                            StrokeShape="RoundRectangle 8" 
                            StrokeThickness="0" 
                            Margin="0,0,0,15"
                            Padding="15">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="{Binding NomePromotor}" 
                                       FontAttributes="Bold" 
                                       FontSize="18" 
                                       TextColor="{StaticResource TextoPrincipal}" />

                                <Label Text="{Binding TituloRecompensa}" 
                                       FontSize="15" 
                                       TextColor="#D4AF37" 
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="Entregue em:" FontSize="11" TextColor="Gray" HorizontalOptions="End"/>
                                <Label Text="{Binding DataResgate, StringFormat='{0:dd/MM/yyyy}'}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- LINHA 2: Botão Voltar -->
        <Button Grid.Row="2" 
                Text="VOLTAR" 
                Command="{Binding VoltarTelaCommand}"
                BorderColor="#D4AF37"
                BorderWidth="3"
                BackgroundColor="{StaticResource FundoPrincipal}" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="20" 
                HeightRequest="50" 
                Margin="0,15,0,0" />
    </Grid>
</ContentPage>