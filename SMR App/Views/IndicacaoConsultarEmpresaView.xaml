<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             xmlns:classesPessoa="clr-namespace:SMRDominio.ClassePessoa;assembly=SMRDominio"
             x:Class="SMR_App.Views.IndicacaoConsultarEmpresaView"
             x:DataType="viewmodels:IndicacaoConsultarEmpresaViewModel"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}">

    <!-- Grid principal divide a tela: Pesquisa (Auto), Lista/Cards (*), Botão Rodapé (Auto) -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- ========================================== -->
        <!-- LINHA 0: Barra de Pesquisa                 -->
        <!-- ========================================== -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,20">
            <Label Text="Pesquisa" 
                   FontAttributes="Bold" 
                   FontSize="16" 
                   TextColor="{StaticResource TextoPrincipal}" />

            <Border BackgroundColor="{StaticResource FundoMenu}" 
                    StrokeShape="RoundRectangle 25" 
                    StrokeThickness="0" 
                    HeightRequest="50" 
                    Padding="10,0">
                <SearchBar x:Name="SearchBarPesquisa"
                           Text="{Binding RazaoSocial}"
                           Placeholder="Digite para buscar..." 
                           PlaceholderColor="Gray"
                           TextColor="{StaticResource TextoPrincipal}"
                           BackgroundColor="Transparent" 
                           CancelButtonColor="{StaticResource TextoPrincipal}"
                           SearchCommand="{Binding ConsultarEmpresaCommand}" />
            </Border>
        </VerticalStackLayout>

        <!-- ========================================== -->
        <!-- LINHA 1: Lista de Empresas (1 Coluna Comprida) -->
        <!-- ========================================== -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding ListaEmpresa}" 
                        SelectionMode="None">

            <!-- 🚀 ALTERADO DE SPAN=2 PARA SPAN=1 PARA FICAR COMPRIDO -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="1" 
                                 VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,30,0,0">
                    <Label Text="Nenhuma empresa encontrada." 
                           TextColor="Gray" 
                           FontSize="16" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="classesPessoa:Empresa">
                    <!-- Card Comprido da Empresa -->
                    <Border BackgroundColor="{StaticResource FundoMenu}" 
                            StrokeShape="RoundRectangle 15" 
                            StrokeThickness="0" 
                            HeightRequest="80" 
                            Padding="15,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:IndicacaoConsultarEmpresaViewModel}}, Path=AbrirCadastroCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <!-- 🚀 GRID HORIZONTAL: Coluna 0 para o Círculo/Logo, Coluna 1 para os Textos -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">

                            <!-- Indicador Visual / Círculo (Igual ao seu print) -->
                            <Ellipse Grid.Column="0"
                                     WidthRequest="45" 
                                     HeightRequest="45" 
                                     Fill="#8B5A5B" 
                                     VerticalOptions="Center" 
                                     HorizontalOptions="Center" />

                            <!-- Textos Empilhados (Razão Social e CNPJ) -->
                            <VerticalStackLayout Grid.Column="1" 
                                                 VerticalOptions="Center" 
                                                 Spacing="2">

                                <!-- RAZÃO SOCIAL -->
                                <Label Text="{Binding razao_social}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="{StaticResource TextoPrincipal}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <!-- CNPJ -->
                                <Label Text="{Binding cnpj, StringFormat='CNPJ: {0}'}" 
                                       FontSize="12" 
                                       TextColor="Gray"
                                       LineBreakMode="NoWrap" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>