<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SMR_App.ViewModels"
             xmlns:classesIndicacao="clr-namespace:SMRDominio.ClasseIndicacao;assembly=SMRDominio"
             x:Class="SMR_App.Views.HistIndicacoesEmpresaView"
             ControlTemplate="{StaticResource MainPageTemplate}"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource FundoPrincipal}"
             x:Name="MinhaPagina">
    <Grid>

        <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,15" VerticalOptions="Center">
                <ImageButton Grid.Column="0" Source="setaesquerda.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30" Command="{Binding EmpresaAnteriorCommand}" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding NomeEmpresaAtual}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <ImageButton Grid.Column="2" Source="setadireita.png" BackgroundColor="Transparent" HeightRequest="30" WidthRequest="30" Command="{Binding ProximaEmpresaCommand}" HorizontalOptions="End" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,0,0,15">

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">

                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                        <Label Text="Progresso da Recompensa" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextoPrincipal}" />
                        <Label Text="Indicações validadas" FontSize="12" TextColor="#AAAAAA" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding PontosPromotor, StringFormat='Total: {0}'}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="{StaticResource TextoPrincipal}" 
                               HorizontalOptions="End" />

                        <Label Text="{Binding Progresso, StringFormat='{0:P0}'}" 
                               FontAttributes="Bold" 
                               FontSize="12" 
                               TextColor="#4CAF50" 
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>

                <Border Stroke="#4CAF50" 
                        StrokeThickness="2" 
                        BackgroundColor="Transparent" 
                        StrokeShape="RoundRectangle 12" 
                        HeightRequest="24" 
                        Padding="2" 
                        Margin="0,5,0,0">
                    
                    <Border StrokeShape="RoundRectangle 10" 
                            StrokeThickness="0" 
                            BackgroundColor="Transparent">
                        

                        <ProgressBar Progress="{Binding Progresso}" 
                                     ProgressColor="#4CAF50" 
                                     BackgroundColor="Transparent" 
                                     VerticalOptions="Center" 
                                     ScaleY="3" />
                    </Border>
                </Border>

            </VerticalStackLayout>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15" Margin="0,0,0,10" VerticalOptions="Center">
                <Label Grid.Column="0" Text="Histórico" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextoPrincipal}" VerticalOptions="Center" />

                <Label Grid.Column="1" Text="{Binding PromotorRank, StringFormat='Nível: {0}'}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextoPrincipal}" VerticalOptions="Center" />

                <Image  Grid.Column="2"
                        Source="filtrohisindicacao.png"
                        HeightRequest="28" 
                        WidthRequest="28">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirFiltroCommand}"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <CollectionView Grid.Row="3" ItemsSource="{Binding ListaIndicacao}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,30,0,0">
                        <Label Text="Nenhum histórico encontrado para esta empresa." TextColor="Gray" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="classesIndicacao:IndicacaoHistoricoDto">

                        <Border BackgroundColor="{StaticResource FundoMenu}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirDetalhesIndicacaoCommand,
                                    Source={x:Reference MinhaPagina}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="5">

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding IDIndicacao}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextoPrincipal}" />
                                            <Label Text="-" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextoPrincipal}" />
                                            <Label Text="{Binding NomeIndicado}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextoPrincipal}" />
                                        </HorizontalStackLayout>

                                        <Border StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding SituacaoTexto}" Value="Pendente">
                                                    <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
                                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SituacaoTexto}" Value="Enviada">
                                                    <Setter Property="BackgroundColor" Value="#1A2196F3" />
                                                    <Setter Property="Stroke" Value="#2196F3" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SituacaoTexto}" Value="Cancelada">
                                                    <Setter Property="BackgroundColor" Value="#1AE63946" />
                                                    <Setter Property="Stroke" Value="#E63946" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding SituacaoTexto}" Value="Validada">
                                                    <Setter Property="BackgroundColor" Value="#1A4CAF50" />
                                                    <Setter Property="Stroke" Value="#4CAF50" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Label Text="{Binding SituacaoTexto}" FontSize="10" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding SituacaoTexto}" Value="Pendente">
                                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding SituacaoTexto}" Value="Enviada">
                                                        <Setter Property="TextColor" Value="#2196F3" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding SituacaoTexto}" Value="Cancelada">
                                                        <Setter Property="TextColor" Value="#E63946" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding SituacaoTexto}" Value="Validada">
                                                        <Setter Property="TextColor" Value="#4CAF50" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </HorizontalStackLayout>

                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding DataIndicacaoFormatada}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding DataValidacaoFormatada}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                                <Image Grid.Column="1" Source="userbarra.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid IsVisible="{Binding IsFiltroAberto}" ZIndex="100">

            <BoxView BackgroundColor="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FecharFiltroCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border BackgroundColor="{StaticResource FundoPrincipal}"
                    Stroke="{StaticResource FundoMenu}" 
                    StrokeThickness="2" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Margin="24"
                    WidthRequest="320"
                    Padding="24" 
                    StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Filtrar Histórico" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextoPrincipal}" 
                           HorizontalOptions="Start" />

                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Data Inicial" 
                                   TextColor="Gray" 
                                   FontSize="13" />
                            <Border BackgroundColor="{StaticResource FundoMenu}" 
                                    StrokeThickness="0" 
                                    StrokeShape="RoundRectangle 8" 
                                    HeightRequest="48"
                                    Padding="8,0">
                                <DatePicker Date="{Binding DataInicial}" 
                                            TextColor="{StaticResource TextoPrincipal}" 
                                            BackgroundColor="Transparent" 
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Data Final" 
                                   TextColor="Gray" 
                                   FontSize="13" />
                            <Border BackgroundColor="{StaticResource FundoMenu}" 
                                    StrokeThickness="0" 
                                    StrokeShape="RoundRectangle 8" 
                                    HeightRequest="48"
                                    Padding="8,0">
                                <DatePicker Date="{Binding DataFinal}" 
                                            TextColor="{StaticResource TextoPrincipal}" 
                                            BackgroundColor="Transparent" 
                                            VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Botões de Ação -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">

                        <!-- Botão Cancelar (Sem borda, texto cinza/branco) -->
                        <Button Grid.Column="0" 
                                Text="Cancelar" 
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextoPrincipal}"
                                BorderColor="Gray"
                                BorderWidth="1"
                                Command="{Binding FecharFiltroCommand}" 
                                HeightRequest="44" />

                        <!-- Botão Filtrar (Verde padrão do seu app) -->
                        <Button Grid.Column="1" 
                                Text="Filtrar" 
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                Command="{Binding SalvarFiltroCommand}" 
                                HeightRequest="44" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>