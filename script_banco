-- ============================================================
-- SCRIPT CONSOLIDADO DO BANCO
-- ============================================================
-- Ordem organizada conforme dependências das Foreign Keys.
--
-- Estrutura:
--   pessoa_tipo
--      └── pessoa
--           ├── empresa
--           └── promotor
--                └── indicacao
--                     └── bonificacao
--
--   empresa
--      ├── recompensa
--      │    └── recompensa_rank
--      └── bonificacao
--
-- ============================================================


-- ============================================================
-- 1. TIPOS DE PESSOA
-- ============================================================

CREATE TABLE IF NOT EXISTS `pessoa_tipo` (
    `id` INT(11) NOT NULL,
    `descricao` VARCHAR(50) NOT NULL,
    PRIMARY KEY (`id`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 2. PESSOA
-- Depende de: pessoa_tipo
-- ============================================================

CREATE TABLE IF NOT EXISTS `pessoa` (
    `id_pessoa` INT(11) NOT NULL AUTO_INCREMENT,
    `id_pessoa_tipo` INT(11) NOT NULL,
    `email` VARCHAR(100) NOT NULL,
    `senha_hash` VARCHAR(255) NOT NULL,
    `data_cadastro` DATETIME DEFAULT CURRENT_TIMESTAMP,
    `ativo` TINYINT(1) DEFAULT 1,
    `nome` VARCHAR(150) DEFAULT NULL,

    PRIMARY KEY (`id_pessoa`),
    UNIQUE KEY `uk_pessoa_email` (`email`),
    KEY `idx_pessoa_tipo` (`id_pessoa_tipo`),

    CONSTRAINT `fk_pessoa_tipo`
        FOREIGN KEY (`id_pessoa_tipo`)
        REFERENCES `pessoa_tipo` (`id`)
        ON DELETE NO ACTION
        ON UPDATE NO ACTION
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 3. EMPRESA
-- Depende de: pessoa
-- ============================================================

CREATE TABLE IF NOT EXISTS `empresa` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `razao_social` VARCHAR(150) DEFAULT NULL,
    `cnpj` VARCHAR(18) NOT NULL,
    `cor_padrao` VARCHAR(7) DEFAULT '#00A0FF',
    `telefone1` VARCHAR(50) DEFAULT NULL,
    `telefone2` VARCHAR(50) DEFAULT NULL,
    `id_pessoa` INT(11) DEFAULT NULL,

    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_empresa_cnpj` (`cnpj`),
    KEY `idx_empresa_pessoa` (`id_pessoa`),

    CONSTRAINT `fk_empresa_pessoa`
        FOREIGN KEY (`id_pessoa`)
        REFERENCES `pessoa` (`id_pessoa`)
        ON DELETE NO ACTION
        ON UPDATE NO ACTION
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 4. PROMOTOR
-- Depende de: pessoa
-- ============================================================

CREATE TABLE IF NOT EXISTS `promotor` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `id_pessoa` INT(11) NOT NULL,
    `cpf` VARCHAR(14) DEFAULT NULL,
    `pontos_acumulados` INT(11) DEFAULT 0,
    `celular` VARCHAR(50) DEFAULT NULL,

    PRIMARY KEY (`id`),
    UNIQUE KEY `uk_promotor_cpf` (`cpf`),
    KEY `idx_promotor_pessoa` (`id_pessoa`),

    CONSTRAINT `fk_promotor_pessoa`
        FOREIGN KEY (`id_pessoa`)
        REFERENCES `pessoa` (`id_pessoa`)
        ON DELETE NO ACTION
        ON UPDATE NO ACTION
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 5. RANK DE RECOMPENSAS
-- ============================================================

CREATE TABLE IF NOT EXISTS `recompensa_rank` (
    `id_rank` INT(11) NOT NULL,
    `descricao` VARCHAR(50) NOT NULL,

    PRIMARY KEY (`id_rank`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 6. DADOS INICIAIS DO RANK
-- ============================================================

INSERT INTO `recompensa_rank` (`id_rank`, `descricao`)
VALUES
    (1, 'Bronze'),
    (2, 'Prata'),
    (3, 'Ouro');


-- ============================================================
-- 7. RECOMPENSA
-- Depende de: empresa e recompensa_rank
-- ============================================================

CREATE TABLE IF NOT EXISTS `recompensa` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `id_empresa` INT(11) NOT NULL,
    `id_rank` INT(11) DEFAULT NULL,
    `titulo` VARCHAR(100) NOT NULL,
    `descricao` VARCHAR(255) DEFAULT NULL,
    `pontos_necessarios` INT(11) NOT NULL,
    `ativo` TINYINT(1) DEFAULT 1,

    PRIMARY KEY (`id`),
    KEY `idx_recompensa_empresa` (`id_empresa`),
    KEY `idx_recompensa_rank` (`id_rank`),

    CONSTRAINT `fk_recompensa_empresa`
        FOREIGN KEY (`id_empresa`)
        REFERENCES `empresa` (`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT `fk_recompensa_rank`
        FOREIGN KEY (`id_rank`)
        REFERENCES `recompensa_rank` (`id_rank`)
        ON DELETE SET NULL
        ON UPDATE CASCADE
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 8. BONIFICAÇÃO
-- Depende de: empresa
-- ============================================================

CREATE TABLE IF NOT EXISTS `bonificacao` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `id_empresa` INT(11) NOT NULL,
    `nome` VARCHAR(150) NOT NULL,
    `descricao` TEXT DEFAULT NULL,
    `valor` DECIMAL(10,2) NOT NULL DEFAULT 0.00,
    `tipo` INT NOT NULL,
    `mgm` TINYINT(1) NOT NULL DEFAULT 0,
    `ativo` TINYINT(1) NOT NULL DEFAULT 1,

    PRIMARY KEY (`id`),
    KEY `idx_bonificacao_empresa` (`id_empresa`),

    CONSTRAINT `fk_bonificacao_empresa`
        FOREIGN KEY (`id_empresa`)
        REFERENCES `empresa` (`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 9. SITUAÇÃO DA INDICAÇÃO
-- ============================================================

CREATE TABLE IF NOT EXISTS `indicacao_situacao` (
    `id_situacao` INT(11) NOT NULL,
    `descricao` VARCHAR(50) NOT NULL,

    PRIMARY KEY (`id_situacao`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 10. DADOS INICIAIS DA SITUAÇÃO DA INDICAÇÃO
-- ============================================================

INSERT INTO `indicacao_situacao` (`id_situacao`, `descricao`)
VALUES
    (1, 'Aberto'),
    (2, 'Finalizado'),
    (3, 'Excluído');


-- ============================================================
-- 11. INDICAÇÃO
-- Depende de: promotor e bonificacao
-- ============================================================

CREATE TABLE IF NOT EXISTS `indicacao` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `id_promotor_indicou` INT(11) NOT NULL,
    `id_bonificacao` INT(11) DEFAULT NULL,
    `nome_indicado` VARCHAR(100) NOT NULL,
    `telefone_indicado` VARCHAR(20) NOT NULL,
    `status_indicacao` ENUM(
        'Pendente',
        'Validada',
        'Cancelada'
    ) DEFAULT 'Pendente',
    `data_indicacao` DATETIME DEFAULT CURRENT_TIMESTAMP,
    `data_validacao` DATETIME DEFAULT NULL,

    PRIMARY KEY (`id`),
    KEY `idx_indicacao_promotor` (`id_promotor_indicou`),
    KEY `idx_indicacao_bonificacao` (`id_bonificacao`),

    CONSTRAINT `fk_indicacao_promotor`
        FOREIGN KEY (`id_promotor_indicou`)
        REFERENCES `promotor` (`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT `fk_indicacao_bonificacao`
        FOREIGN KEY (`id_bonificacao`)
        REFERENCES `bonificacao` (`id`)
        ON DELETE SET NULL
        ON UPDATE CASCADE
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 12. SOLICITAÇÃO DE RESGATE
-- Depende de: promotor e recompensa
-- ============================================================

CREATE TABLE IF NOT EXISTS `solicitacao_resgate` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `id_promotor` INT(11) NOT NULL,
    `id_recompensa` INT(11) NOT NULL,
    `data_solicitacao` DATETIME DEFAULT CURRENT_TIMESTAMP,
    `status_solicitacao` ENUM(
        'Solicitada',
        'Validada',
        'Cancelada'
    ) DEFAULT 'Solicitada',
    `data_validacao` DATETIME DEFAULT NULL,

    PRIMARY KEY (`id`),
    KEY `idx_resgate_promotor` (`id_promotor`),
    KEY `idx_resgate_recompensa` (`id_recompensa`),

    CONSTRAINT `fk_resgate_promotor`
        FOREIGN KEY (`id_promotor`)
        REFERENCES `promotor` (`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT `fk_resgate_recompensa`
        FOREIGN KEY (`id_recompensa`)
        REFERENCES `recompensa` (`id`)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 13. CLIENTES IMPORTADOS
-- Não possui FK no script original
-- ============================================================

CREATE TABLE IF NOT EXISTS `cliente_importado` (
    `id_cliente_importado` INT(11) NOT NULL AUTO_INCREMENT,
    `id_empresa` INT(11) NOT NULL,
    `nome` VARCHAR(150) NOT NULL,
    `documento` VARCHAR(20) NOT NULL,
    `data_importacao` DATETIME DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (`id_cliente_importado`),
    KEY `idx_cliente_importado_empresa_documento`
        (`id_empresa`, `documento`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


-- ============================================================
-- 14. RECUPERAÇÃO DE SENHA
-- Não possui FK no script original
-- ============================================================

CREATE TABLE IF NOT EXISTS `recuperacao_senha` (
    `id_recuperacao` INT(11) NOT NULL AUTO_INCREMENT,
    `email` VARCHAR(150) NOT NULL,
    `codigo` VARCHAR(6) NOT NULL,
    `data_geracao` DATETIME DEFAULT CURRENT_TIMESTAMP,
    `data_expiracao` DATETIME NOT NULL,
    `utilizado` TINYINT(1) DEFAULT 0,

    PRIMARY KEY (`id_recuperacao`),
    KEY `idx_recuperacao_email_codigo`
        (`email`, `codigo`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


